# Copy to .env and fill in. Everything is optional: without a key the app uses rule-based incident summaries.

# Claude incident summaries. Empty = deterministic rule-based summary.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# auto (default): Claude when ANTHROPIC_API_KEY is set | rules | claude
SENTINEL_LLM=auto

# Storage
SENTINEL_DB=logsentinel.db
# Generate 7 days of synthetic telemetry (with incidents) when the database is empty
SENTINEL_SEED_DEMO=true
SENTINEL_DEMO_DAYS=7

# Detection and forecasting
SENTINEL_Z_THRESHOLD=4
SENTINEL_FORECAST_WINDOW_HOURS=6
SENTINEL_FORECAST_HORIZON_HOURS=48

# Logging: JSON lines on stdout
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=true
